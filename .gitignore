# Go / Wails build artifacts
build/bin/
build/darwin/
*.exe

# Frontend build output + deps
# Kept: main.go embeds frontend/dist, so `go vet`/`go build` need it to exist
# in a fresh clone (the SDLC sandbox builds without running the frontend).
frontend/dist/*
!frontend/dist/.gitkeep
frontend/node_modules/

# Wails generated JS bindings — regenerated by `wails build` / `wails
# generate module`. We DO commit them so consumers can browse the API
# surface without a full build. Uncomment to exclude:
# frontend/wailsjs/

# Local SQLite DBs (per-user; the tool creates ~/.claude/claude_trace.db)
*.db
*.db-wal
*.db-shm

# macOS
.DS_Store

# Editor state
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.local
